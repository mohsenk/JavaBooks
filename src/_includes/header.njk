<header class="site-header">
  <div class="wrap">
    <a class="brand" href="{{ '/' | relative_url }}">
      <span class="cup" aria-hidden="true">☕</span>
      <span>Awesome Java Books</span>
    </a>
    <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="mainNav">
      <span aria-hidden="true">☰</span>
      <span class="visually-hidden">Menu</span>
    </button>
    <nav class="main-nav" id="mainNav" aria-label="Primary">
      <ul>
        <li class="has-dropdown">
          <button class="dropdown-toggle" id="booksToggle" aria-expanded="false" aria-controls="booksMenu">
            Browse Books <span class="caret" aria-hidden="true">▾</span>
          </button>
          <div class="dropdown-menu" id="booksMenu">
            {% for cat in site.category_pages %}
            {% set catdata = books | findBySlug(cat.slug) %}
            <a href="{{ ('/books/' + cat.slug + '/') | relative_url }}" class="{% if cat.slug in page.url %}active{% endif %}">
              <span class="dm-icon">{{ catdata.icon }}</span>
              <span>{{ cat.title }}</span>
            </a>
            {% endfor %}
          </div>
        </li>
        <li><a href="{{ '/about/' | relative_url }}" {% if page.url == '/about/' %}class="active"{% endif %}>About</a></li>
      </ul>
    </nav>
  </div>
</header>
